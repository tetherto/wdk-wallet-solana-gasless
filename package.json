{
  "name": "@tetherto/wdk-wallet-solana-gasless",
  "version": "1.0.0-beta.8",
  "description": "Solana wallet module for WDK (Wallet Development Kit) by Tether with paymaster support for gasless transfers.",
  "homepage": "https://docs.wdk.tether.io/sdk/wallet-modules/wallet-solana-gasless/",
  "keywords": [
    "wdk",
    "wallet",
    "slip-10",
    "solana",
    "gasless"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-wallet-solana-gasless.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/addresses": "8.3.0",
    "@solana/kit": "8.6.0",
    "@solana/kit-plugin-instruction-plan": "0.19.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/kit-plugin-signer": "0.19.0",
    "@solana/kora": "0.3.0",
    "@solana/rpc": "8.3.0",
    "@solana/signers": "8.3.0",
    "@solana/transaction-messages": "8.3.0",
    "@solana/transactions": "8.3.0",
    "@tetherto/wdk-failover-provider": "1.0.0-beta.2",
    "@tetherto/wdk-wallet": "1.0.0-beta.26",
    "@tetherto/wdk-wallet-solana": "1.0.0-beta.22",
    "bare-node-runtime": "^1.5.2"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "jest": "30.4.2",
    "standard": "17.1.2",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    },
    "./signers": {
      "types": "./types/src/signers/index.d.ts",
      "bare": "./src/signers/bare.js",
      "default": "./src/signers/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "tests/**/*.js"
    ]
  }
}
